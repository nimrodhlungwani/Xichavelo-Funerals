@{
    Layout = "_Layout";
}

<section class="py-5 bg-light-custom">
    <div class="container py-5">
        <div class="text-center mb-5 scroll-animate">
            <span class="text-primary-red fw-bold text-uppercase tracking-wider">Information Desk Center</span>
            <h1 class="display-4 fw-bold mt-2">Frequently Answered Parameters</h1>
            <p class="lead text-muted">Clear responses to essential policy implementation questions.</p>
            <div class="mx-auto bg-gold mt-3" style="width: 60px; height: 3px;"></div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 scroll-animate">
                <div class="accordion accordion-flush shadow-sm rounded-3 overflow-hidden" id="faqAccordionSystem">

                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button fw-bold py-3 text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseOne" aria-expanded="true" aria-controls="faqCollapseOne">
                                What is the exact policy waiting period enforced?
                            </button>
                        </h2>
                        <div id="faqCollapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordionSystem">
                            <div class="accordion-body text-muted">
                                We utilize a standard, strict <strong>4-month waiting period</strong> structure for all newly generated accounts. However, this wait schedule is completely waived if you are transitioning an active, valid existing insurance policy schedule directly from another registered funeral society entity.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed fw-bold py-3 text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseTwo" aria-expanded="false" aria-controls="faqCollapseTwo">
                                Are there restrictions regarding age limits or member family surnames?
                            </button>
                        </h2>
                        <div id="faqCollapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordionSystem">
                            <div class="accordion-body text-muted">
                                No. Xichavelo policies are built to accommodate your modern family reality. We enforce <strong>no age limit barriers</strong>, and we comfortably cover multi-member structures possessing <strong>different surnames</strong> under single consolidated schedules.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed fw-bold py-3 text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseThree" aria-expanded="false" aria-controls="faqCollapseThree">
                                How does the dynamic Cash Payout Guarantee clause operate?
                            </button>
                        </h2>
                        <div id="faqCollapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordionSystem">
                            <div class="accordion-body text-muted">
                                If for any unpredictable operational reason our dedicated logistics team is unable to render physical services (casket delivery, hearse dispatch, home setup) directly during a verified claim event, the plan triggers an immediate direct liquidity backup payout: <strong>R2,000.00 for Gold Plan</strong> accounts and <strong>R3,000.00 for Platinum Plan</strong> accounts.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingFour">
                            <button class="accordion-button collapsed fw-bold py-3 text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseFour" aria-expanded="false" aria-controls="faqCollapseFour">
                                What auxiliary components are provided for grave arrangements?
                            </button>
                        </h2>
                        <div id="faqCollapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordionSystem">
                            <div class="accordion-body text-muted">
                                We are comprehensive funeral infrastructure providers. We natively provide structural <strong>Mampara Bricks</strong> and send highly experienced, expert <strong>Grave Builders</strong> to ensure construction is performed gracefully and safely.
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_CallToActionPartial" />