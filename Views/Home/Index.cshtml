@{
    Layout = "_Layout";
}

<partial name="_HeroSection" />

<section class="py-5 bg-white">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 scroll-animate">
                <div class="position-relative">
                    <img src="~/images/images (3).jpg" alt="Xichavelo Operations Headquarters" class="img-fluid rounded-3 shadow" style="width:100%; object-fit:cover; height:400px;" />
                    <div class="position-absolute bottom-0 end-0 bg-primary-red text-white p-4 rounded-start shadow-lg mb-3">
                        <h5 class="text-gold mb-0 fw-bold">Est. 2019</h5>
                        <p class="small mb-0 text-white-50">REG NO. 2019/540274/07</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 scroll-animate">
                <span class="text-primary-red fw-bold text-uppercase tracking-wider">Welcome to Xichavelo Funerals</span>
                <h2 class="display-5 fw-bold mt-2 mb-4">Built on Compassion, Integrity, and Trust</h2>
                <p class="text-muted">Xichavelo Funerals & Financial Services stands as a cornerstone partner to families experiencing the sensitivity of deep loss. We combine empathetic cultural understanding with exceptional operational execution, ensuring your final farewell arrays remain strictly flawless, respectful, and affordable.</p>
                <a asp-controller="Home" asp-action="About" class="btn btn-premium-red mt-3">Read Our Full Legacy Structure</a>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light-custom">
    <div class="container py-5">
        <div class="text-center mb-5 scroll-animate">
            <span class="text-primary-red fw-bold text-uppercase tracking-wider">Operational Portfolio</span>
            <h2 class="display-5 fw-bold mt-2">Honoring Lives Beautifully</h2>
            <div class="mx-auto bg-gold mt-3" style="width: 60px; height: 3px;"></div>
        </div>
        <partial name="_GalleryPartial" />
    </div>
</section>

<partial name="_CallToActionPartial" />