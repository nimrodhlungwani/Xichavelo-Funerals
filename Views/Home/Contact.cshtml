@model Xichavelo.Web.Models.ContactViewModel
@{
    Layout = "_Layout";
}

<section class="py-5 bg-light-custom" style="margin-top: 80px;">
    <div class="container py-5">
        <div class="text-center mb-5 scroll-animate">
            <span class="text-primary-red fw-bold text-uppercase tracking-wider">Contact Channels</span>
            <h1 class="display-4 fw-bold mt-2">Connect With Our 24/7 Command Desk</h1>
            <div class="mx-auto bg-gold mt-3" style="width: 70px; height: 3px;"></div>
        </div>

        <div class="row g-5 align-items-stretch">
            
            <!-- Left Column: Corporate Contact Metrics & Map -->
            <div class="col-lg-4 d-flex flex-column">
                
                <!-- Contact Details Box -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h4 class="fw-bold mb-4 text-dark">Corporate Contact Metrics</h4>
                    
                    <div class="d-flex mb-3">
                        <div class="me-3 text-gold fs-4"><i class="fas fa-map-marker-alt"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Main Head Office</h6>
                            <p class="small text-muted mb-0">
                                Office No.01, Olga's Place, Opposite Engine Garage, Nordia Phalaborwa, 1390
                            </p>
                        </div>
                    </div>

                    <div class="d-flex mb-3">
                        <div class="me-3 text-gold fs-4"><i class="fas fa-phone-alt"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Instant Support Link Line</h6>
                            <p class="small text-muted mb-0">Operational Desk: +27 78 979 1377</p>
                            <p class="small text-muted mb-0">Emergency Backup Line: +27 78 955 1313</p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="me-3 text-gold fs-4"><i class="fas fa-envelope"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Digital Processing Inbox</h6>
                            <p class="small text-muted mb-0">info@xichavelofunerals.co.za</p>
                            <p class="small text-muted mb-0">compliance@xichavelofunerals.co.za</p>
                        </div>
                    </div>
                </div>

                <!-- Google Maps Embed Card (Stretches to fill remaining vertical height) -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white flex-grow-1 min-h-250">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14631.144931835697!2d31.1275344!3d-23.9503612!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1ec612a45d045d67%3A0x868b419b48c4155b!2sPhalaborwa!5e0!3m2!1sen!2sza!4v1716900000000!5m2!1sen!2sza" width="100%" height="100%" style="border:0; min-height: 250px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"> </iframe>
                </div>

            </div>

            <!-- Right Column: Digital Message Desk Form -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white h-100">
                    <h3 class="fw-bold mb-4 text-dark">Transmit a Digital Message Desk</h3>

                    <form method="post" asp-action="SubmitInquiry">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Full Name</label>
                                <input type="text" class="form-control bg-light border-0 p-3" placeholder="e.g. Thabo Smith" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Phone Number</label>
                                <input type="tel" class="form-control bg-light border-0 p-3" placeholder="e.g. +27789791377" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Email</label>
                            <input type="email" class="form-control bg-light border-0 p-3" placeholder="info@company.co.za" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Subject</label>
                            <select class="form-select bg-light border-0 p-3">
                                <option selected>-- Choose Priority Subject Topic --</option>
                                <option value="policy">Funeral Cover Policy Query</option>
                                <option value="claim">Claim Processing Support</option>
                                <option value="general">General Information</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small">Message</label>
                            <textarea class="form-control bg-light border-0 p-3" rows="4" placeholder="Please outline any information requirements explicitly here..."></textarea>
                        </div>

                        <button type="submit" class="btn text-white w-100 p-3 fw-bold rounded-3" style="background-color: #8B0000;">
                            Transmit Secure Strategy Message
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>