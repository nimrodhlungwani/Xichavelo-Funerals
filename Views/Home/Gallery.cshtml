@{
    Layout = "_Layout";
}

<section class="py-5 bg-white">
    <div class="container text-center py-3">

        <!-- Header Section -->
        <h1 class="display-5 fw-bold mb-2">My Visual Diary</h1>
        <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
            See our compassionate care through our lens: honoring memories in photos and moments
        </p>

        <!-- Category Filter Pills -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
            <button class="filter-pill active" data-filter="all">All</button>
            <button class="filter-pill" data-filter="funeral-services">Funeral Services</button>
            <button class="filter-pill" data-filter="shatells">Shatells</button>
            <button class="filter-pill" data-filter="staff">Staff</button>
            <button class="filter-pill" data-filter="directors">Directors</button>
            <button class="filter-pill" data-filter="decoration">Decoration</button>
        </div>

        <!-- Uniform Grid Layout -->
        <div class="row g-4 justify-content-center" id="galleryContainer">

            <div class="col-lg-4 col-md-6 gallery-item" data-category="funeral-services">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Funeral Services" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Services</span>
                        <h6 class="mb-0 text-white fw-bold">Honoring Services</h6>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 gallery-item" data-category="shatells">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Shatells Setup" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Shatells</span>
                        <h6 class="mb-0 text-white fw-bold">Custom Setups</h6>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 gallery-item" data-category="decoration">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Decoration Setup" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Decoration</span>
                        <h6 class="mb-0 text-white fw-bold">Premium Layouts</h6>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 gallery-item" data-category="staff">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Our Dedicated Staff" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Staff</span>
                        <h6 class="mb-0 text-white fw-bold">Support Team</h6>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 gallery-item" data-category="staff">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Our Dedicated Staff" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Staff</span>
                        <h6 class="mb-0 text-white fw-bold">Admin Team</h6>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 gallery-item" data-category="staff">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Our Dedicated Staff" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Staff</span>
                        <h6 class="mb-0 text-white fw-bold">Office Team</h6>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 gallery-item" data-category="directors">
                <div class="gallery-card">
                    <div class="img-wrapper">
                        <img src="~/images/funeral-banner.jpeg" alt="Directors Overview" />
                    </div>
                    <div class="gallery-overlay text-start">
                        <span class="badge bg-gold text-dark mb-1">Directors</span>
                        <h6 class="mb-0 text-white fw-bold">Executive Leadership</h6>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- Lightbox Modal -->
<div class="modal fade" id="galleryViewComponentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 text-end">
            <button type="button" class="btn-close btn-close-white ms-auto mb-2" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body p-0 text-center">
                <img src="" id="modalViewportTargetImage" class="img-fluid rounded shadow-lg" alt="Target Viewport Render Element" style="max-height: 85vh; width: auto; display: inline-block;" />
            </div>
        </div>
    </div>
</div>