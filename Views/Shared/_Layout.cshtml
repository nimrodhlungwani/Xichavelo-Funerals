<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Xichavelo Funerals & Financial Services</title>

    <meta name="description" content="Xichavelo Funerals & Financial Services offers elegant, compassionate, and highly professional family protection policies. Gold and Platinum plans designed to wipe your tears off." />
    <meta name="keywords" content="Xichavelo funerals, funeral insurance, gold policy, platinum funeral plan, casket, tombstones, South Africa funeral cover, financial services" />
    <meta property="og:title" content="@ViewData["Title"] - Xichavelo Funerals & Financial Services" />
    <meta property="og:description" content="Dignified insurance support structures for your family starting from R200/month. Standard policy options covering up to 15 members." />
    <meta property="og:type" content="website" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <partial name="_Navbar" />

    <main role="main" class="p-0 m-0">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <div class="floating-social-container">
        <a href="https://wa.me/27789791377?text=Hello%20Xichavelo%20Team,%20I%20would%20like%20to%20inquire%20about%20a%20funeral%20plan." class="floating-trigger trigger-whatsapp text-decoration-none" target="_blank" aria-label="Chat via WhatsApp"> <i class="fab fa-whatsapp"></i> <span class="fab-tooltip">Chat via WhatsApp</span> </a>
        <a href="https://tiktok.com" class="floating-trigger trigger-tiktok text-decoration-none" target="_blank" aria-label="Follow us on TikTok"> <i class="fab fa-tiktok"></i> <span class="fab-tooltip">Follow on TikTok</span> </a>
        <a href="https://facebook.com" class="floating-trigger trigger-facebook text-decoration-none" target="_blank" aria-label="Visit Facebook Page"> <i class="fab fa-facebook-f"></i> <span class="fab-tooltip">Facebook Page</span> </a>
        <a href="mailto:info@xichavelofunerals.co.za?subject=Inquiry%20regarding%20Funeral%20Plans" class="floating-trigger trigger-email text-decoration-none" aria-label="Send us an Email"> <i class="fas fa-envelope"></i> <span class="fab-tooltip">Email Support</span> </a>
    </div>

    <div class="modal fade" id="complimentModal" tabindex="-1" aria-labelledby="complimentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="complimentModalLabel">Compliments &amp; Complaints</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <p class="mb-4"> Send us a quick message on WhatsApp to leave a compliment. It’s fast, easy, and helps us keep serving families with care. </p>
                    <a href="https://api.whatsapp.com/send/?phone=27212066516&amp;text=I+would+like+to+write+a+review+about+Two+Mountains&amp;app_absent=0" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-lg"><i class="fab fa-whatsapp me-2"></i>Write a Compliment</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>