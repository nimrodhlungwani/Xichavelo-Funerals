                <div class="border border-4 border-gold p-2 rounded-4 shadow-lg overflow-hidden transform-rotate-3 transition-all duration-500 hover-rotate-0">
                    <img src="images/funeral-banner.jpeg" alt="Dignified Premium Ceremony Presentation Casket" class="img-fluid rounded-3" style="min-height: 350px; object-fit: cover; width:100%;" />
                </div>
            </div>
