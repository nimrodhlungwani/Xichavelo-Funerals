<section class="hero-wrapper d-flex align-items-center">
    <div class="container relative-position text-center text-lg-start py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge bg-gold text-dark px-3 py-2 fs-6 fw-semibold mb-3 rounded-1 tracking-wider uppercase">TRUSTED FAMILY PROTECTION</span>
                <h1 class="display-3 fw-bold text-white mb-3 leading-tight">Dignified Funeral Services You Can Trust</h1>
                <p class="lead text-white-50 mb-5 fs-4">"We wipe your tears off" with absolute compassionate operational support, premium fleets, and comprehensive community infrastructure layout plans.</p>
                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
